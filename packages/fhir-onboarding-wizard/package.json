{
  "name": "@opensrp/fhir-onboarding-wizard",
  "version": "0.0.1",
  "description": "FHIR Onboarding Wizard components for opensrp web",
  "main": "dist/index.js",
  "types": "dist/types",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/OpenSRP/web/",
  "scripts": {
    "test": "run -T test $INIT_CWD --verbose",
    "tsc": "run -T tsc",
    "lint": "run -T eslint ./**/*.{js,jsx,ts,tsx}",
    "copy": "run -T copyfiles -u 1 \"./src/**/*.{css,html}\" \"./dist/\"",
    "build": "run tsc && run transpile && run copy",
    "transpile": "run -T babel src -d dist --root-mode upward --extensions .ts,.tsx --ignore '**/*.test.ts,**/*.test.tsx,**/tests,**/__tests__'"
  },
  "jest": {
    "automock": false,
    "setupFiles": [
      "../../setupTests"
    ]
  },
  "bugs": {
    "url": "https://github.com/OpenSRP/web/issues"
  },
  "author": "OpenSRP Engineering",
  "license": "Apache-2.0",
  "dependencies": {
    "@onaio/utils": "^0.0.1",
    "@opensrp/react-utils": "^0.0.12",
    "@smile-cdr/fhirts": "^1.2.5",
    "@opensrp/fhir-care-team": "^0.0.1",
    "@opensrp/fhir-location-management": "^0.0.1",
    "@opensrp/user-management": "^0.0.1",
    "@opensrp/fhir-team-management": "^0.0.5",
    "uuid": "^8.3.1"
  },
  "devDependencies": {
    "@types/uuid": "8.3.0",
    "nock": "^13.0.6"
  },
  "peerDependencies": {
    "antd": "^5.5.2",
    "react": "17.0.0",
    "react-query": "^3.15.1"
  }
}
